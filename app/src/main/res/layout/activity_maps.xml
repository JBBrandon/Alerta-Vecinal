<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F1F1">

    <!-- Mapa principal -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <!-- Botón para centrar en mi ubicación -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMyLocation"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/centrar_en_mi_ubicaci_n"
        android:src="@android:drawable/ic_menu_mylocation"
        app:backgroundTint="@color/white"
        app:tint="@color/colorPrimary"
        app:elevation="6dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="50dp"/>

    <!-- Botón para añadir nuevo reporte -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddReport"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/a_adir_reporte"
        android:src="@drawable/ic_add_alert"
        app:backgroundTint="@color/colorPrimary"
        app:tint="@android:color/white"
        app:elevation="6dp"
        android:scaleType="centerInside"
        app:layout_constraintEnd_toStartOf="@id/fabMyLocation"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/fabReportsList"
        android:layout_marginBottom="50dp"
        tools:ignore="MissingConstraints" />

    <!-- Lista de reportes (inicialmente invisible) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewReportes"
        android:layout_width="320dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="#FFF"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="16dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"/>

    <!-- Botón para mostrar/ocultar lista -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabReportsList"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/mostrar_lista_de_reportes"
        android:src="@drawable/ic_list"
        app:backgroundTint="@color/colorPrimary"
        app:elevation="6dp"
        app:tint="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="50dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
